    {
      "parameters": {
        "jsCode": "// 获取 Supabase 节点返回的所有数据\nconst items = $input.all();\n\nif (items.length === 0) {\n  return []; // 如果没有未处理消息，则停止执行\n}\n\n// 提取需要的字段并拼接成一段文本\nlet combinedText = \"【待处理消息列表】\\n\\n\";\nconst processedIds = [];\n\nitems.forEach((item, index) => {\n  const data = item.json;\n  processedIds.push(data.id); // 保存主键 ID，后续更新状态用\n  \n  combinedText += `--- 消息 #${index + 1} ---\\n`;\n  combinedText += `Time: ${data.date}\\n`;\n  combinedText += `Message ID: ${data.message_id}\\n`;\n  combinedText += `链接: ${data.message_url || '无'}\\n`;\n  combinedText += `内容: ${data.text || data.raw_text || '无内容'}\\n\\n`;\n});\n\n// 返回聚合后的数据及 ID 列表\nreturn [{\n  json: {\n    combined_prompt: combinedText,\n    ids_to_update: processedIds,\n    count: items.length\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        48,
        -624

# 复制为 .env 并填写;.env 已被 .gitignore 忽略,不会进仓库。
# 采集账号凭据(my.telegram.org 创建应用获取)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+86...

# 目标群清单:chat_id:显示名;多个用分号分隔(登录脚本会列出账号可见的群与 ID)
TELEGRAM_CHATS=

# 可选
TELEGRAM_SESSION_PATH=data/telegram.session

# 发布渠道(可选;都未配置时发布器回退为本地文件输出)
# PUBLISH_OUT_DIR=data/publish
# PUBLISH_MIN_INTERVAL_S=300
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PUBLISH_CHAT=
# DISCORD_WEBHOOK_URL=
